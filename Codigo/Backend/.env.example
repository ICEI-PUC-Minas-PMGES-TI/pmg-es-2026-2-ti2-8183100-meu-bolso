# Copie este arquivo para ".env" (que NAO vai para o Git) e preencha os valores.
# NUNCA coloque credenciais reais aqui no .env.example.

# ----- Banco de dados (MongoDB Atlas) -----
MONGODB_URI=

# ----- Seguranca (JWT) -----
# O segredo do JWT precisa ter pelo menos 32 caracteres.
APP_JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais-caracteres

# ----- Transporte de e-mail -----
# Como o e-mail sai:
#   smtp  (padrao): usa as variaveis MAIL_* abaixo (Mailpit local ou Gmail).
#   brevo: usa a API HTTP da Brevo (porta 443). Necessario em hospedagens que
#          bloqueiam SMTP, como o Render Free. Exige BREVO_API_KEY e um
#          MAIL_FROM com remetente VERIFICADO na conta da Brevo.
APP_MAIL_PROVIDER=smtp
# Chave da API da Brevo (so usada quando APP_MAIL_PROVIDER=brevo). Comeca com "xkeysib-".
BREVO_API_KEY=

# ----- E-mail da recuperacao de senha (SMTP) -----
# Usado quando APP_MAIL_PROVIDER=smtp. Em desenvolvimento, sem preencher, o
# back envia para o Mailpit local (http://localhost:8025). Para enviar de
# verdade pelo Gmail, preencha (MAIL_PASSWORD = "senha de app" do Google, NAO
# a senha da conta). Com APP_MAIL_PROVIDER=brevo, só o MAIL_FROM importa (e
# deve ser o remetente verificado na Brevo).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu.email@gmail.com
MAIL_PASSWORD=senha-de-app-de-16-letras
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=seu.email@gmail.com

# ----- Chatbot WhatsApp (WAHA) -----
# O WAHA roda em container Docker local, pareado a um numero por QR Code.
# URL da API do WAHA e nome da sessao criada nele (POST /api/sessions).
WAHA_API_URL=http://localhost:3000
WAHA_SESSION=default
# Chave da API do WAHA: a MESMA passada ao container em -e WAHA_API_KEY=...
WAHA_API_KEY=troque-por-uma-chave-da-api-do-waha
# Protecoes para numero PESSOAL (padrao). Com numero dedicado ao bot, use:
#   WHATSAPP_PALAVRA_ATIVACAO=            (vazio: qualquer mensagem chama o bot)
#   WHATSAPP_RESPONDER_NAO_CADASTRADOS=true
WHATSAPP_PALAVRA_ATIVACAO=meu bolso
WHATSAPP_RESPONDER_NAO_CADASTRADOS=false

# ----- Chat do assistente (Jarvis) via Gemini -----
# Chave da Gemini API (console do Google AI Studio); vazia = IA desligada.
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash-lite

# Limites de uso do chat do Jarvis (contadores em memória; zeram ao reiniciar).
IA_LIMITE_DIARIO_USUARIO=15
IA_LIMITE_DIARIO_GLOBAL=450
IA_LIMITE_POR_MINUTO=12
IA_ZONA_USUARIO=America/Sao_Paulo
IA_ZONA_GLOBAL=America/Los_Angeles
