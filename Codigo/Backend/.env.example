# Copie este arquivo para ".env" (que NAO vai para o Git) e preencha os valores.
# NUNCA coloque credenciais reais aqui no .env.example.

# ----- Banco de dados (MongoDB Atlas) -----
MONGODB_URI=

# ----- Seguranca (JWT) -----
# O segredo do JWT precisa ter pelo menos 32 caracteres.
APP_JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais-caracteres

# ----- E-mail da recuperacao de senha -----
# Em desenvolvimento, sem preencher, o back envia para o Mailpit local
# (http://localhost:8025). Para enviar de verdade pelo Gmail, preencha
# (MAIL_PASSWORD = "senha de app" do Google, NAO a senha da conta):
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu.email@gmail.com
MAIL_PASSWORD=senha-de-app-de-16-letras
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=seu.email@gmail.com

# ----- Chatbot WhatsApp (Cloud API, Meta) -----
# Token de verificacao do webhook: valor livre, escolhido por voce, e
# informado IGUAL no painel da Meta ao cadastrar o webhook.
WHATSAPP_VERIFY_TOKEN=meubolso-webhook-dev
# Credenciais do painel da Meta (WhatsApp > API Setup) - para ENVIAR mensagens:
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# App Secret (App settings > Basic) - usado para validar a assinatura do webhook:
WHATSAPP_APP_SECRET=
