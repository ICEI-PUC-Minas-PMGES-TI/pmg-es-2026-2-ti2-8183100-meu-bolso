# Copie para .env (que NAO vai para o Git) e troque o valor.
# O segredo do JWT precisa ter pelo menos 32 caracteres.
APP_JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais-caracteres

# ----- E-mail da recuperação de senha (opcional em desenvolvimento) -----
# Sem nada abaixo, o back envia para o Mailpit local (http://localhost:8025).
# Para enviar e-mail de verdade pelo Gmail, descomente e preencha
# (MAIL_PASSWORD = "senha de app" do Google, NÃO a senha da conta):
#MAIL_HOST=smtp.gmail.com
#MAIL_PORT=587
#MAIL_USERNAME=seu.email@gmail.com
#MAIL_PASSWORD=senha-de-app-de-16-letras
#MAIL_SMTP_AUTH=true
#MAIL_STARTTLS=true
#MAIL_FROM=seu.email@gmail.com
